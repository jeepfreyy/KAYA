{
  "manifest_version": 3,
  "name": "Kaya Mode",
  "version": "0.3.0",
  "description": "Understand pages and forms, or guide users through original form fields, using local AI through Ollama.",
  "minimum_chrome_version": "126",
  "key": "",
  "permissions": ["activeTab", "scripting", "sidePanel"],
  "host_permissions": ["http://localhost:11434/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Open Kaya Mode" },
  "side_panel": { "default_path": "panel.html" }
}
